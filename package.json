{
  "name": "shiguang-collector",
  "version": "1.3.1",
  "description": "拾光 · 文字与图片的本地收藏夹",
  "main": "main.js",
  "author": "Sky",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.cjs",
    "test:e2e": "node tests/e2e.cjs"
  },
  "build": {
    "appId": "local.shiguang.collector",
    "productName": "拾光",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "storage-manager.js",
      "startup.js",
      "ui/**/*",
      "assets/icon.*",
      "assets/brand.svg",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "rcedit": "^5.0.2"
  }
}
